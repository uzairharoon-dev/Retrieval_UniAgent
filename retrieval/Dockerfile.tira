FROM ghcr.io/uniagent-webis-de/uniagent-pyterrier-baseline:dev-0.0.1@sha256:955bc071aefd3868e6d7292e4f02ee6579f781d66ed2e683354432b0c7de3d8e

WORKDIR /app
# Match the evaluator dependency used in the validated development image.
RUN pip3 install --no-cache-dir trectools==0.0.50
COPY baseline.py fusion.py fusion_system.py representations.py representation_system.py german-stopwords.txt german-stopwords.NOTICE test_baseline.py test_token_length.py test_fusion.py test_representations.py /app/
RUN PYTHONPATH=. pytest .
ENTRYPOINT ["python3", "/app/representation_system.py", "--mode", "passages", "--use-description"]
